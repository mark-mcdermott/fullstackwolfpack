{
  "name": "fullstack-wolfpack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fw/web",
    "dev:site": "npm run dev -w @fw/site",
    "dev:all": "concurrently -k -n web,site -c blue,magenta \"npm run dev -w @fw/web\" \"npm run dev -w @fw/site\"",
    "build": "npm run build -w @fw/web",
    "preview": "npm run preview -w @fw/web",
    "test": "npm run test -w @fw/web",
    "test:watch": "npm run test:watch -w @fw/web",
    "lint": "npm run lint -w @fw/web",
    "db:seed": "npm run db:seed -w @fw/web",
    "db:reset-dev": "npm run db:reset-dev -w @fw/web",
    "gen:builtins": "npm run gen:builtins -w @fw/web --",
    "db:generate": "npm run db:generate -w @fw/web",
    "db:migrate": "npm run db:migrate -w @fw/web",
    "db:push": "npm run db:push -w @fw/web",
    "db:studio": "npm run db:studio -w @fw/web",
    "tauri": "npm run tauri -w @fw/web",
    "tauri:build:prod": "npm run tauri:build:prod -w @fw/web",
    "cap": "npm run cap -w @fw/web",
    "cap:sync": "npm run cap:sync -w @fw/web",
    "cap:sync:prod": "npm run cap:sync:prod -w @fw/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
