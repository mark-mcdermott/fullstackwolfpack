{
  "name": "fullstack-wolfpack",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @fw/site dev",
    "build": "pnpm --filter @fw/site build",
    "preview": "pnpm --filter @fw/site preview",
    "test": "pnpm --filter @fw/site test",
    "test:watch": "pnpm --filter @fw/site test:watch",
    "lint": "pnpm --filter @fw/site lint",
    "db:seed": "pnpm --filter @fw/site db:seed",
    "db:reset-dev": "pnpm --filter @fw/site db:reset-dev",
    "db:park": "pnpm --filter @fw/site db:park",
    "gen:builtins": "pnpm --filter @fw/site gen:builtins",
    "db:generate": "pnpm --filter @fw/site db:generate",
    "db:migrate": "pnpm --filter @fw/site db:migrate",
    "db:push": "pnpm --filter @fw/site db:push",
    "db:studio": "pnpm --filter @fw/site db:studio",
    "tauri": "pnpm --filter @fw/site tauri",
    "tauri:build:prod": "pnpm --filter @fw/site tauri:build:prod",
    "cap": "pnpm --filter @fw/site cap",
    "cap:sync": "pnpm --filter @fw/site cap:sync",
    "cap:sync:prod": "pnpm --filter @fw/site cap:sync:prod"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
