# Neon Postgres connection string — SERVER-SIDE ONLY, never expose to the client.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# WebAuthn relying party config
RP_ID="localhost"
RP_ORIGIN="http://localhost:5173"

# Session cookie signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# At-rest encryption key for stored secrets (TOTP + provider API keys).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-long-random-string"

# AI tutor + short-answer grading (education Phase 3). Users normally add their
# own key in Settings (encrypted per-user); these optional PLATFORM keys are a
# fallback so the features work from .env alone. Anthropic (Claude) is preferred.
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# Model overrides (defaults: Haiku 4.5 grader, Sonnet 5 tutor, gpt-4o-mini):
# ANTHROPIC_GRADER_MODEL="claude-haiku-4-5"
# ANTHROPIC_TUTOR_MODEL="claude-sonnet-5"
# OPENAI_MODEL="gpt-4o-mini"
