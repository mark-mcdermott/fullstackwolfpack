# Neon Postgres connection string — SERVER-SIDE ONLY, never expose to the client.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# WebAuthn relying party config
RP_ID="localhost"
RP_ORIGIN="http://localhost:5173"

# Session cookie signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# At-rest encryption key for stored secrets (TOTP + provider API keys).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-long-random-string"

# Dev Mode role switcher (deleted-later feature). Always on in local dev.
# Set to 1 on a DEPLOY to expose the top-right role switcher there too.
# WARNING: while enabled, POST /api/me/become mints a session for a test user
# with NO auth — anyone who can reach the site can become admin. Leave unset in
# any environment with real users. Changing it requires a redeploy (the client
# gate is inlined at build time).
# VITE_ENABLE_DEV_MODE="1"

# AI tutor + short-answer grading (education Phase 3). Users normally add their
# own key in Settings (encrypted per-user); these optional PLATFORM keys are a
# fallback so the features work from .env alone. Anthropic (Claude) is preferred.
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# Model overrides (defaults: Haiku 4.5 grader, Sonnet 5 tutor, gpt-4o-mini):
# ANTHROPIC_GRADER_MODEL="claude-haiku-4-5"
# ANTHROPIC_TUTOR_MODEL="claude-sonnet-5"
# OPENAI_MODEL="gpt-4o-mini"

# Stripe billing (Pro subscription). All SERVER-SIDE ONLY. Billing is dormant
# until STRIPE_SECRET_KEY is set — the Upgrade/Manage buttons just report that
# billing is unavailable. Redirect URLs are derived from RP_ORIGIN.
#   - Secret key:  Stripe Dashboard → Developers → API keys (use sk_test_… first)
#   - Price ID:    create a recurring $9/mo Product → copy its price id (price_…)
#   - Webhook secret: `stripe listen --forward-to localhost:5173/api/me/stripe-webhook`
#     for local dev, or the signing secret of a Dashboard webhook pointed at
#     https://<app-domain>/api/me/stripe-webhook. Subscribe to at least
#     checkout.session.completed, customer.subscription.updated, .deleted.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Native / desktop shells (Capacitor + Tauri). Both bundle the static build but
# have no backend of their own, and auth is WebAuthn RP-origin-bound — so a
# packaged build must reach the deployed prod origin.
#   - CAP_SERVER_URL: Capacitor loads the whole webview from this origin (read at
#     `cap sync` time by capacitor.config.ts), so the JS origin matches RP_ORIGIN
#     and passkeys work. Leave unset for local dev (loads the bundled dist).
#   - VITE_API_BASE: build-time prefix for the app's `/api/*` calls (baked into the
#     bundle by Vite). Use for a Tauri/shell build that serves the bundled dist but
#     needs to reach the prod API. Empty (web default) = same-origin.
# CAP_SERVER_URL="https://app.fullstackwolfpack.com"
# VITE_API_BASE="https://app.fullstackwolfpack.com"
