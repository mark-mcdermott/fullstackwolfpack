---
import '../styles/global.css'
import WolfMark from '../components/WolfMark.astro'
import Icon from '../components/Icon.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Fullstack Wolfpack',
  description = 'Turn screen time into real world skills.',
} = Astro.props

// Parked with the fuller footer's copyright line (commented out below).
// const year = new Date().getFullYear()

const navLinks = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
]

const path = Astro.url.pathname

// Parked with the nav row below — bottom-right links are hidden for now, just a
// copyright. Restore both together.
// const footerNav = [
//   { label: 'How It Works', href: '/how-it-works' },
//   { label: 'Features', href: '/features' },
//   { label: 'Pricing', href: '/pricing' },
//   { label: 'Blog', href: '/blog' },
//   { label: 'About Us', href: '/about' },
// ]

// Parked while we zoom in on the core loop — the full link columns + social
// row. Restore alongside the fuller footer markup commented out below.
// const footerCols = [
//   {
//     title: 'Platform',
//     links: [
//       { label: 'How It Works', href: '/how-it-works' },
//       { label: 'Features', href: '/features' },
//       { label: 'Pricing', href: '/pricing' },
//       { label: 'Games We Support', href: '#' },
//     ],
//   },
//   {
//     title: 'Resources',
//     links: [
//       { label: 'Blog', href: '/blog' },
//       { label: 'Guides', href: '#' },
//       { label: 'Help Center', href: '#' },
//       { label: 'Community', href: '#' },
//     ],
//   },
//   {
//     title: 'Company',
//     links: [
//       { label: 'About Us', href: '/about' },
//       { label: 'Careers', href: '#' },
//       { label: 'Privacy Policy', href: '#' },
//       { label: 'Terms of Service', href: '#' },
//     ],
//   },
// ]
//
// const socials = [
//   { name: 'discord', href: '#', label: 'Discord' },
//   { name: 'x', href: '#', label: 'X' },
//   { name: 'youtube', href: '#', label: 'YouTube' },
//   { name: 'github', href: '#', label: 'GitHub' },
// ] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://use.typekit.net/ctl2pql.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Light by default; honor a saved dark choice (shared with the app on the
      // same domain) before first paint to avoid a flash.
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark')
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-background font-sans text-foreground antialiased"
  >
    <header class="bg-background text-foreground">
      <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 md:px-3"
      >
        <a href="/" class="flex gap-2.5 md:gap-5">
          <WolfMark class="h-11 text-foreground md:h-18" />
          <span class="flex flex-col gap-1 font-heading text-[13px] leading-none tracking-wide md:text-[19px]">
            <span>FULLSTACK</span>
            <span>WOLFPACK</span>
            <span class="mt-1 text-[10px] font-normal text-primary md:text-[15px]">ウルフパック</span>
          </span>
        </a>

        <nav
          class="hidden items-center gap-7 font-heading text-[12px] tracking-widest uppercase lg:flex"
        >
          {
            navLinks.map((n) => (
              <a
                href={n.href}
                aria-current={n.href === path ? 'page' : undefined}
                class:list={[
                  'border-b-2 pb-1 transition-colors hover:text-foreground',
                  n.href === path
                    ? 'border-primary text-primary'
                    : 'border-transparent text-muted-foreground',
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2 md:gap-3">
          <button
            type="button"
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="inline-flex items-center justify-center p-2 text-muted-foreground transition-colors hover:text-foreground"
          >
            <Icon name="moon" class="size-4 dark:hidden" />
            <Icon name="sun" class="hidden size-4 dark:block" />
          </button>
          <div class="flex items-center gap-4 md:grid md:grid-cols-[3fr_4fr]">
          <div
            class="hidden h-16 flex-col gap-1 border border-border px-3 md:flex"
          >
            <div class="flex items-center gap-1.5 mt-2">
              <span
                class="font-mono text-[9px] tracking-tight font-bold font-heading text-muted-foreground uppercase"
                >System status</span
              >
              <span class="h-1 w-1 rounded-full bg-primary mb-0.5"></span>
            </div>
            <span class="font-mono text-[9px] tracking-widest text-primary font-bold uppercase relative mb-0.5"
              >Online</span
            >
            <span class="fw-barcode-regular h-2 w-30 text-muted-foreground"></span>
          </div>

          <a
            href="/start"
            class="fw-notch-br fw-notch-tr flex h-16 items-center justify-center gap-1.5 bg-primary px-4 py-2.5 text-xs font-heading font-semibold tracking-widest whitespace-nowrap text-primary-foreground uppercase transition-colors hover:bg-primary/90 md:gap-2.5 md:pl-7 md:pr-4 md:py-6.5 md:text-sm"
          >
            Start Learning
            <Icon name="arrow" class="h-4 w-4 md:h-7 md:w-7 md:ml-3" />
          </a>
          </div>
        </div>
      </div>
    </header>

    <script is:inline>
      // Dark-mode toggle — mirrors the logged-in app: flip `.dark` on <html>
      // and persist to the shared `theme` key (the no-flash <head> script above
      // reapplies it on the next page load).
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark')
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light')
        } catch (e) {
          /* private mode — ignore */
        }
      })
    </script>

    <main><slot /></main>

    <footer class="bg-background text-muted-foreground">
      {/* Skyline band — Akela's creed + the terminal readout over the city.
          The band stays dark in both themes (it's a photograph; light text over
          it reads in either mode) — only the chrome around it flips. */}
      <div class="relative overflow-hidden">
        <img
          src="/images/footer-2.png"
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover object-center"
        />
        {/* Scrims: an overall darken, a heavier left wash for the quote, and a
            bottom fade into the nav row. */}
        <div class="absolute inset-0 bg-neutral-950/55"></div>
        <div
          class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/50 to-transparent"
        >
        </div>
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-background to-transparent"
        >
        </div>

        <div
          class="relative mx-auto flex min-h-[7.5rem] max-w-7xl flex-col justify-center gap-8 px-5 py-6 md:min-h-[9.5rem] md:flex-row md:items-center md:justify-between md:px-8"
        >
          {/* Akela's creed */}
          <blockquote class="max-w-md">
            <span
              aria-hidden="true"
              class="block font-heading text-6xl leading-none text-primary"
              >&ldquo;</span
            >
            <p
              class="-mt-4 font-mono text-sm leading-relaxed text-neutral-100 sm:text-base"
            >
              Discipline is choosing between what you want now and what you want
              most.
            </p>
            <cite
              class="mt-3 block font-mono text-xs tracking-widest text-primary uppercase not-italic"
              >— Akela</cite
            >
          </blockquote>

          {/* Terminal readout */}
          <div
            class="fw-notch-tr w-full max-w-[15rem] shrink-0 border border-neutral-700 bg-neutral-950/70 p-4 pt-6 backdrop-blur-sm"
          >
            <div class="flex flex-col gap-2 font-mono text-sm tracking-wide">
              <span class="text-primary">&gt; LOCK IN</span>
              <span class="text-blue-400">&gt; KEEP LEARNING</span>
              <span class="text-primary">&gt; LEVEL UP</span>
            </div>
            <div class="fw-barcode mt-6 h-3 w-full text-neutral-600"></div>
          </div>
        </div>
      </div>

      {/* Slim brand + nav row */}
      <div class="border-t border-border">
        <div
          class="mx-auto flex max-w-7xl flex-col items-center gap-5 px-5 py-6 md:flex-row md:justify-between md:px-8"
        >
          <a href="/" aria-label="Fullstack Wolfpack home" class="flex items-center gap-2.5">
            <WolfMark class="h-8 text-primary" />
            <span class="font-mono text-lg font-bold text-primary">ウルフパック</span>
          </a>
          {/* Nav links parked while we focus the flow — a status readout for now.
          <nav class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
            {
              footerNav.map((n) => (
                <a
                  href={n.href}
                  class="font-mono text-xs tracking-wide text-muted-foreground uppercase transition-colors hover:text-foreground"
                >
                  {n.label}
                </a>
              ))
            }
          </nav>
          */}
          {/* Status readout — all one muted color; each item reads as a phrase,
              not a key/value pair. */}
          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1.5 font-mono text-xs text-muted-foreground">
            <span class="flex items-center gap-1.5">
              API
              <span class="size-1.5 rounded-full bg-green-500"></span>
              Healthy
            </span>
            <span>Build v0.1.0</span>
            <span>Deployed 2h ago</span>
            <span>Env Production</span>
            <span>&copy; 2026</span>
          </div>
        </div>
      </div>

      {/* Parked — the fuller footer (tagline, link columns, terminal cell,
          social row, copyright). Restore when we widen scope again.
      <div class="mx-auto max-w-7xl px-5 pt-14 pb-8 md:px-8">
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2.5">
            <WolfMark class="h-9 text-white" />
            <span class="font-mono text-lg font-bold text-primary">ウルフパック</span>
          </div>
          <p class="max-w-[15rem] font-mono text-xs leading-relaxed">
            Fullstack Wolfpack helps gamers level up in game and in life.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-2 gap-8 md:grid-cols-4">
          {footerCols.map((col) => (
            <div class="flex flex-col gap-3">
              <h3 class="font-mono text-[11px] font-bold tracking-widest text-white uppercase">{col.title}</h3>
              <ul class="flex flex-col gap-2">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="font-mono text-xs text-neutral-400 transition-colors hover:text-white">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="relative flex flex-col border border-neutral-700 pt-6 p-4 sm:max-w-[15rem] xl:max-w-none">
            <div class="flex flex-col gap-1.5 font-mono text-xs tracking-wide text-neutral-200">
              <span>&gt; LOCK IN</span>
              <span>&gt; KEEP LEARNING</span>
              <span>&gt; KEEP LEVELING UP</span>
            </div>
            <div class="fw-barcode mt-8 h-3 w-full text-neutral-600"></div>
          </div>
        </div>

        <div class="mt-12 flex flex-col gap-5 border-t border-neutral-800 pt-6 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-5">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} class="text-neutral-500 transition-colors hover:text-white">
                <Icon name={s.name} class="h-[18px] w-[18px]" />
              </a>
            ))}
          </div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[10px] tracking-widest text-neutral-500 uppercase">
            <span>© <span id="footer-year">{year}</span> Fullstack Wolfpack · All rights reserved</span>
            <Icon name="globe" class="h-3.5 w-3.5 text-neutral-400" />
          </div>
        </div>
      </div>
      */}
    </footer>

    {/* Parked with the copyright line above — reinstate when the year is shown again.
    <script>
      // Keep the footer year current on the client, so a long-unbuilt static
      // page never shows a stale year (the SSR value is just the no-flash seed).
      const yearEl = document.getElementById('footer-year')
      if (yearEl) yearEl.textContent = String(new Date().getFullYear())
    </script>
    */}
  </body>
</html>
