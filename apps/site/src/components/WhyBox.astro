---
// Bordered "why" strip: a red eyebrow over four icon/title/body columns.
// Shared by the sign-in and sign-up pages.
import Icon from './Icon.astro'

interface Props {
  eyebrow: string
  items: readonly { icon: string; title: string; body: string }[]
}

const { eyebrow, items } = Astro.props

const triTopLeft =
  'border-width: 14px 14px 0 0; border-style: solid; border-color: var(--foreground) transparent transparent transparent;'
const triBottomRight =
  'border-width: 0 0 14px 14px; border-style: solid; border-color: transparent transparent var(--foreground) transparent;'
---

<div class="relative border border-neutral-600 px-6 py-8 md:px-10">
  <span class="pointer-events-none absolute left-0 top-0 h-0 w-0" style={triTopLeft}></span>
  <span
    class="pointer-events-none absolute right-0 bottom-0 h-0 w-0"
    style={triBottomRight}></span>
  <p class="font-mono text-[11px] tracking-widest text-primary uppercase">
    // {eyebrow}
  </p>
  <div
    class="mt-8 grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4 md:gap-0 md:divide-x md:divide-neutral-300"
  >
    {
      items.map((it) => (
        <div class="relative isolate md:px-6 md:first:pl-0 md:last:pr-0">
          <span
            class="fw-diaglines pointer-events-none absolute inset-2 -z-10 text-foreground opacity-[0.015]"
            aria-hidden="true"
          />
          <Icon name={it.icon as never} class="h-8 w-8 text-foreground" />
          <h3 class="mt-3 font-heading text-sm font-semibold tracking-normal uppercase">
            {it.title}
          </h3>
          <p class="mt-2 font-mono text-xs leading-relaxed text-muted-foreground">
            {it.body}
          </p>
        </div>
      ))
    }
  </div>
</div>
