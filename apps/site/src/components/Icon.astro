interface Props {
  name: keyof typeof icons | keyof typeof brand
  class?: string
}

const { name, class: className = '' } = Astro.props
const isBrand = name in brand
const markup = isBrand
  ? brand[name as keyof typeof brand]
  : icons[name as keyof typeof icons]
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={markup}
/>
