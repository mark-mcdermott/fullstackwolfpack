---
// "OR CONTINUE WITH" divider + Google / GitHub / Discord buttons. The static
// site hands auth off to the app, so each provider links there.
import Icon from './Icon.astro'
import { APP_URL } from '../consts'

interface Props {
  label: string
}

const { label } = Astro.props

const providers = [
  { name: 'google', label: 'Google' },
  { name: 'github', label: 'GitHub' },
  { name: 'discord', label: 'Discord' },
] as const
---

<div>
  <div class="flex items-center gap-4">
    <span class="h-px flex-1 bg-border"></span>
    <span class="font-mono text-[11px] tracking-widest text-muted-foreground uppercase">
      {label}
    </span>
    <span class="h-px flex-1 bg-border"></span>
  </div>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
    {
      providers.map((p) => (
        <a
          href={`${APP_URL}/app`}
          class="flex items-center justify-center gap-2.5 border border-neutral-300 py-3.5 font-mono text-xs font-bold tracking-widest uppercase transition-colors hover:border-foreground"
        >
          <Icon name={p.name} class="h-5 w-5" />
          {p.label}
        </a>
      ))
    }
  </div>
</div>
