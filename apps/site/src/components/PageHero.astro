---
// Shared hero for the logged-out content pages (About / How it works /
// Features / Pricing): back-link, eyebrow, two-line heading with a red period,
// body copy, and the FW-01 wolf visual with a HUD dot grid + optional FM label.
import Icon from './Icon.astro'

interface Props {
  eyebrow: string
  titleTop: string
  titleBottom: string
  body: string
  fm?: string
}

const { eyebrow, titleTop, titleBottom, body, fm } = Astro.props
---

<a
  href="/"
  class="mt-8 inline-flex items-center gap-2 font-mono text-[11px] font-bold tracking-widest text-muted-foreground uppercase transition-colors hover:text-foreground"
>
  <Icon name="arrow" class="h-4 w-4 rotate-180" />
  Back to home
</a>

<section class="relative overflow-hidden pt-6 pb-10">
  <div class="grid items-center gap-y-10 md:grid-cols-2 md:gap-x-10 md:gap-y-0">
    <div class="flex max-w-xl flex-col gap-6">
      <p class="font-mono text-xs tracking-normal text-primary uppercase">
        // {eyebrow}
      </p>
      <h1
        class="font-heading text-4xl leading-[0.95] tracking-tight uppercase sm:text-5xl lg:text-[3.5rem]"
      >
        <span class="block">{titleTop}</span>
        <span class="block">{titleBottom}<span class="text-primary">.</span></span>
      </h1>
      <p class="max-w-md font-mono text-[15px] leading-relaxed text-neutral-700">
        {body}
      </p>
      <slot />
    </div>

    <!-- Visual: wolf art + HUD dot grid -->
    <div class="relative mx-auto w-full max-w-md md:mx-0 md:max-w-none">
      <div class="absolute right-0 top-2 z-10 hidden items-start gap-3 lg:flex">
        <span class="mt-1 font-mono text-sm text-foreground/40">+</span>
        <div class="grid grid-cols-5 gap-x-3 gap-y-2.5">
          {
            Array.from({ length: 30 }).map(() => (
              <span class="h-1 w-1 rounded-full bg-foreground/30" />
            ))
          }
        </div>
      </div>
      <img
        src="/images/wolf-sun-transparent.png"
        alt="Ink illustration of a wolf's head against a red rising sun"
        class="w-full"
        loading="eager"
        width="800"
        height="663"
      />
      {
        fm && (
          <span class="absolute right-1 -bottom-1 font-mono text-[11px] tracking-widest text-muted-foreground">
            {fm}
          </span>
        )
      }
    </div>
  </div>
</section>
