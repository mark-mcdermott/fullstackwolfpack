---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import CornerMarks from '../components/CornerMarks.astro'
import { APP_URL } from '../consts'

const stats = [
  {
    icon: 'gamepad',
    value: '30/10',
    label: 'Play / Learn',
    sub: 'Minutes per session',
  },
  {
    icon: 'crosshair',
    value: 'AI',
    label: 'Curated Courses',
    sub: 'Built for your goals',
  },
  {
    icon: 'signal',
    value: '3+',
    label: 'Platforms',
    sub: 'Web · Mobile · Desktop',
  },
  {
    icon: 'book',
    value: 'Any',
    label: 'Topic',
    sub: 'You pick, we build it',
  },
] as const

const steps = [
  {
    num: '01',
    icon: 'gamepad',
    title: 'You Play',
    body: 'Set a timer and enjoy your favorite game.',
  },
  {
    num: '02',
    icon: 'bell',
    title: 'We Pause',
    body: "When time's up, we pause the game.",
  },
  {
    num: '03',
    icon: 'book',
    title: 'You Learn',
    body: 'Complete a short lesson or answer questions.',
  },
  {
    num: '04',
    icon: 'crosshair',
    title: 'You Level Up',
    body: 'Track progress and build real world skills.',
  },
] as const

const features = [
  {
    icon: 'cpu',
    title: 'AI Curated Lessons',
    body: 'Personalized content based on your goals and progress.',
  },
  {
    icon: 'signal',
    title: 'Multi-Platform',
    body: 'Works with PC, console, and mobile games.',
  },
  {
    icon: 'trending',
    title: 'Detailed Progress',
    body: 'Visualize your growth and track your streaks.',
  },
  {
    icon: 'users',
    title: 'Built to Motivate',
    body: 'Gamified experience that keeps you coming back for more.',
  },
] as const

const whyStats = [
  {
    num: '2.4',
    suffix: 'x',
    label: 'Higher Retention',
    body: 'Compared to traditional learning.',
    source: 'Cognitive Science Research',
  },
  {
    num: '45',
    suffix: '%',
    label: 'More Consistent',
    body: 'Users who learn in intervals stay more consistent.',
    source: 'Learning Lab Study 2025',
  },
  {
    num: '98',
    suffix: '%',
    label: 'User Satisfaction',
    body: 'Of users feel more productive and motivated.',
    source: 'Wolfpack User Survey',
  },
] as const

const triTopLeft =
  'border-width: 14px 14px 0 0; border-style: solid; border-color: var(--foreground) transparent transparent transparent;'
const triBottomRight =
  'border-width: 0 0 14px 14px; border-style: solid; border-color: transparent transparent var(--foreground) transparent;'
---

<Base>
  <!-- 2 · Hero -->
  <section class="relative overflow-hidden">
    <CornerMarks class="text-foreground/25" />
    <div
      class="mx-auto grid max-w-7xl items-center px-5 pt-8 pb-6 md:px-8 md:pt-10 md:pb-10 lg:grid-cols-2"
    >
      <div class="flex flex-col gap-6">
        <p class="font-mono text-xs font-bold tracking-normal text-primary uppercase">
          // AI-Powered Learning Platform
        </p>
        <h1
          class="font-heading text-6xl font-semibold leading-[0.88] tracking-tight uppercase sm:text-7xl lg:text-[6.5rem]"
        >
          <span class="block">Learn.</span>
          <span class="block">Play.</span>
          <span class="block text-primary">Level up.</span>
        </h1>
        <p
          class="max-w-sm font-mono text-base leading-relaxed tracking-wide text-neutral-600 uppercase"
        >
          Turn screen time<br />into real world skills.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={`${APP_URL}/app`}
            class="fw-notch-tr inline-flex items-center gap-2.5 bg-primary px-6 py-3.5 font-mono text-xs font-bold tracking-widest text-primary-foreground uppercase transition-colors hover:bg-primary/90"
          >
            <Icon name="crosshair" class="h-4 w-4" />
            Start Session
          </a>
          <a
            href={`${APP_URL}/app`}
            class="inline-flex items-center gap-2.5 border border-foreground px-6 py-3.5 font-mono text-xs font-bold tracking-widest uppercase transition-colors hover:bg-foreground hover:text-background"
          >
            View Dashboard
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
        <p
          class="font-mono text-[11px] tracking-widest text-neutral-600 uppercase"
        >
          30 Min Play // 10 Min Learn
        </p>
      </div>

      <!-- Visual: wolf art + FW-01 HUD rail -->
      <div class="relative">
        <!-- FW-01 badge, far top-right -->
        <div class="absolute right-0 top-0 z-20 flex items-center gap-2 font-mono">
          <span
            class="bg-foreground px-2 py-1 text-[10px] font-bold tracking-widest text-background"
            >FW-01</span
          >
          <span class="text-[11px] tracking-widest text-muted-foreground"
            >⌗ ⌗ ⌗</span
          >
        </div>
        <span
          class="absolute right-0 top-9 z-20 font-mono text-[10px] tracking-widest text-muted-foreground"
          >v1.0.0</span
        >

        <div class="flex items-center pt-1">
          <div class="relative flex-1">
            <img
              src="/images/wolf-sun-transparent.png"
              alt="Ink illustration of a wolf against a red rising sun"
              class="w-full"
              loading="eager"
              width="800"
              height="663"
            />
            <!-- coordinates + measurement line -->
            <div class="absolute -bottom-3 right-0 left-0 z-10 flex flex-col items-end gap-1.5">
              <div
                class="flex items-center gap-2 font-mono text-[10px] tracking-widest text-muted-foreground"
              >
                <Icon name="crosshair" class="h-3.5 w-3.5 text-primary" />
                <span id="coords">35.6895° N, 139.6917° E</span>
              </div>
              <div class="relative h-px w-40 bg-foreground/20">
                <div class="absolute top-0 left-0 h-px w-1/3 bg-foreground/60"></div>
              </div>
            </div>
          </div>

          <!-- Right HUD rail -->
          <div
            class="hidden shrink-0 flex-col items-center gap-8 self-stretch pt-2 lg:flex"
          >
            <!-- 3-column dot grid -->
            <div class="grid grid-cols-3 gap-1.5">
              {
                Array.from({ length: 15 }).map(() => (
                  <span class="h-1 w-1 rounded-full bg-foreground/30" />
                ))
              }
            </div>

            <!-- measurement line: + dashes dot dashes + -->
            <div
              class="flex flex-col items-center gap-1.5 font-mono text-[10px] text-foreground/40"
            >
              <span>+</span>
              <span class="h-7 border-l border-dashed border-foreground/30"></span>
              <span class="h-1 w-1 rounded-full bg-foreground/50"></span>
              <span class="h-7 border-l border-dashed border-foreground/30"></span>
              <span>+</span>
            </div>

            <!-- vertical scroll indicator: + / SCROLL / +++++ -->
            <div
              class="flex flex-col items-center gap-2 font-mono text-[10px] text-foreground/40"
            >
              <span>+</span>
              <span
                class="tracking-[0.35em] uppercase [writing-mode:vertical-rl]"
                >Scroll</span
              >
              <span class="tracking-widest [writing-mode:vertical-rl]">+++++</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Stats bar -->
  <section class="mx-auto max-w-7xl px-5 pb-16 md:px-8">
    <div class="relative border border-neutral-600 px-6 py-8 md:px-10">
      <span class="pointer-events-none absolute left-0 top-0 h-0 w-0" style={triTopLeft}></span>
      <span
        class="pointer-events-none absolute right-0 bottom-0 h-0 w-0"
        style={triBottomRight}></span>
      <div
        class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4 md:gap-0 md:divide-x md:divide-neutral-300"
      >
        {
          stats.map((s) => (
            <div class="flex items-center gap-4 md:px-8 md:first:pl-0">
              <Icon name={s.icon} class="h-9 w-9 shrink-0 text-primary" />
              <div class="flex flex-col">
                <span class="font-heading text-3xl font-semibold leading-none uppercase">
                  {s.value}
                </span>
                <span class="mt-1.5 font-mono text-[11px] font-bold tracking-widest uppercase">
                  {s.label}
                </span>
                <span class="mt-0.5 font-mono text-[10px] tracking-widest text-muted-foreground uppercase">
                  {s.sub}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4 · How it works -->
  <section
    id="how-it-works"
    class="relative overflow-hidden bg-neutral-950 text-white"
  >
    <CornerMarks class="text-white" />
    <div class="mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-16">
      <p class="font-mono text-xs tracking-[0.25em] text-primary uppercase">
        // How it works
      </p>
      <h2
        class="mt-4 font-display text-3xl leading-[0.95] tracking-tight uppercase sm:text-4xl"
      >
        Learn in intervals.<br />Retain forever.
      </h2>

      <div
        class="mt-14 flex flex-col gap-10 md:flex-row md:items-start md:gap-4"
      >
        {
          steps.map((step, i) => (
            <Fragment>
              <div class="flex flex-1 flex-col">
                <Icon name={step.icon} class="h-9 w-9 text-white" />
                <div class="mt-3 mb-1 font-sans text-2xl text-primary">
                  {step.num}
                </div>
                <h3 class="font-mono text-sm font-bold tracking-widest text-white uppercase">
                  {step.title}
                </h3>
                <p class="mt-1.5 max-w-[13rem] font-mono text-[11px] leading-relaxed text-neutral-400">
                  {step.body}
                </p>
              </div>
              {i < steps.length - 1 && (
                <div class="hidden shrink-0 pt-2 md:block md:w-16 lg:w-[88px]">
                  <svg
                    viewBox="0 0 88 20"
                    class="w-full text-white/70"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M2 10h76" />
                    <path d="M78 2 86 10 78 18" />
                  </svg>
                </div>
              )}
            </Fragment>
          ))
        }
      </div>
    </div>
    <div class="fw-hazard absolute right-6 bottom-6 h-4 w-24 text-primary"></div>
  </section>

  <!-- 5 · Features -->
  <section id="features" class="relative overflow-hidden">
    <CornerMarks class="text-foreground/25" />
    <div class="mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-16">
      <p class="font-mono text-xs tracking-[0.25em] text-primary uppercase">
        // Features
      </p>
      <h2
        class="mt-4 font-display text-3xl leading-[0.95] tracking-tight uppercase sm:text-4xl"
      >
        Built for gamers.<br />Designed for growth.
      </h2>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((f) => (
            <div class="relative border border-border bg-background p-6">
              <span
                class="pointer-events-none absolute left-0 top-0 h-0 w-0"
                style={triTopLeft}
              />
              <span class="absolute right-3 top-3 font-mono text-sm text-muted-foreground">
                +
              </span>
              <span class="pointer-events-none absolute bottom-0 left-0 h-3 w-3 border-b border-l border-foreground/40" />
              <span class="pointer-events-none absolute right-0 bottom-0 h-3 w-3 border-r border-b border-foreground/40" />
              <Icon name={f.icon} class="mb-6 h-9 w-9 text-foreground" />
              <h3 class="mb-2 font-mono text-sm font-bold tracking-widest uppercase">
                {f.title}
              </h3>
              <p class="font-mono text-xs leading-relaxed text-muted-foreground">
                {f.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6 · Why it works -->
  <section class="relative border-t border-neutral-300">
    <div class="mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-16">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div class="flex flex-col gap-6">
          <p class="font-mono text-xs tracking-[0.25em] text-primary uppercase">
            // Why it works
          </p>
          <h2
            class="font-display text-3xl leading-[0.95] tracking-tight uppercase sm:text-4xl"
          >
            Short bursts.<br />Lasting impact.
          </h2>
          <p class="max-w-md font-mono text-sm leading-relaxed text-muted-foreground">
            Science shows spaced learning with active recall improves retention
            and builds real mastery over time.
          </p>
          <a
            href="#features"
            class="inline-flex items-center gap-2 font-mono text-xs font-bold tracking-widest text-primary uppercase transition-opacity hover:opacity-70"
          >
            Learn more
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>

        <div
          class="grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-neutral-300"
        >
          {
            whyStats.map((s) => (
              <div class="flex flex-col gap-2 sm:px-6 sm:first:pl-0">
                <div class="font-heading text-5xl font-semibold leading-none text-primary sm:text-6xl">
                  {s.num}
                  <span class="text-3xl sm:text-4xl">{s.suffix}</span>
                </div>
                <div class="font-mono text-xs font-bold tracking-widest uppercase">
                  {s.label}
                </div>
                <p class="font-mono text-[11px] leading-relaxed text-muted-foreground">
                  {s.body}
                </p>
                <p class="mt-3 font-mono text-[10px] leading-relaxed text-muted-foreground/60">
                  Source: {s.source}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · CTA band -->
  <section class="relative overflow-hidden bg-primary text-primary-foreground">
    <CornerMarks class="text-white/40" />
    <div
      class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-10 md:flex-row md:items-center md:justify-between md:px-8 md:py-14"
    >
      <div class="flex flex-col gap-4">
        <p class="font-mono text-xs tracking-[0.25em] text-white/80 uppercase">
          <span class="text-white">//</span> Ready to level up?
        </p>
        <h2
          class="font-display text-3xl leading-[0.95] tracking-tight uppercase sm:text-4xl"
        >
          Your next level<br />starts now.
        </h2>
      </div>
      <a
        href={`${APP_URL}/app`}
        class="fw-notch-tr inline-flex items-center justify-between gap-6 bg-white px-7 py-4 font-mono text-xs font-bold tracking-widest text-foreground uppercase transition-colors hover:bg-white/90"
      >
        <span class="inline-flex items-center gap-2.5">
          <Icon name="crosshair" class="h-4 w-4 text-primary" />
          Start Your Session
        </span>
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <div class="fw-hazard absolute right-5 bottom-5 h-4 w-24 text-white/70"></div>
  </section>
</Base>

<script>
  // Show the visitor's approximate coordinates in the hero HUD; fall back to the
  // mock's Tokyo readout if geolocation lookup is unavailable.
  const el = document.getElementById('coords')
  if (el) {
    fetch('https://ipapi.co/json/')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d) => {
        const { latitude, longitude } = d ?? {}
        if (typeof latitude === 'number' && typeof longitude === 'number') {
          const lat = `${Math.abs(latitude).toFixed(4)}° ${latitude >= 0 ? 'N' : 'S'}`
          const lon = `${Math.abs(longitude).toFixed(4)}° ${longitude >= 0 ? 'E' : 'W'}`
          el.textContent = `${lat}, ${lon}`
        }
      })
      .catch(() => {})
  }
</script>
