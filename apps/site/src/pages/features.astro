---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import CornerMarks from '../components/CornerMarks.astro'
import PageHero from '../components/PageHero.astro'
import { APP_URL } from '../consts'

const features = [
  {
    icon: 'target',
    title: 'AI Curated Lessons',
    body: 'Personalized content based on your goals, experience, and progress.',
  },
  {
    icon: 'bars',
    title: 'Multi-Platform',
    body: 'Learn on web, mobile, console, or desktop. Your progress goes wherever you go.',
  },
  {
    icon: 'growth',
    title: 'Detailed Progress',
    body: 'Visualize your growth with clear stats, streaks, and milestones.',
  },
  {
    icon: 'users',
    title: 'Built to Motivate',
    body: 'Gamified learning, challenges, and rewards keep you engaged and coming back.',
  },
  {
    icon: 'shield',
    title: 'Real World Skills',
    body: 'Learn skills you can actually use. From junior devs to seasoned pros.',
  },
  {
    icon: 'zap',
    title: 'Short, Focused Sessions',
    body: 'Bite-sized lessons designed for busy lives. Make every minute count.',
  },
  {
    icon: 'community',
    title: 'Community Driven',
    body: 'Join a global community of learners, share wins, and grow together.',
  },
  {
    icon: 'trophy',
    title: 'Achieve & Unlock',
    body: 'Earn XP, unlock achievements, and climb the ranks as you level up.',
  },
] as const

const stats = [
  {
    icon: 'user',
    value: '50K+',
    label: 'Learners',
    body: 'Developers leveling up every day.',
  },
  {
    icon: 'trophy',
    value: '2.3M+',
    label: 'Sessions',
    body: 'Short bursts that drive real growth.',
  },
  {
    icon: 'book',
    value: '1,200+',
    label: 'Lessons & Quizzes',
    body: 'Curated content across tech and beyond.',
  },
  {
    icon: 'globe',
    value: '150+',
    label: 'Countries',
    body: 'A global pack of lifelong learners.',
  },
] as const
---

<Base
  title="Features — Fullstack Wolfpack"
  description="Built for gamers, designed for growth. Every feature in Wolfpack turns screen time into real skill."
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <PageHero
      eyebrow="Features"
      titleTop="Built for gamers."
      titleBottom="Designed for growth"
      body="Every feature in Wolfpack is crafted to turn your screen time into real skill. Learn actively. Stay motivated. See progress. Level up."
      fm="FM · 03"
    />

    <!-- Feature grid -->
    <section class="border-t border-border pt-10 pb-14 lg:pt-0">
      <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0">
        {
          features.map((f, i) => (
            <article
              class:list={[
                'relative flex flex-col lg:p-7 lg:pb-9',
                i >= 4 && 'lg:border-t lg:border-border',
                i % 4 !== 0 && 'lg:border-l lg:border-border',
              ]}
            >
              <Icon name={f.icon} class="h-11 w-11 text-foreground" />
              <span class="mt-6 font-mono text-xs text-muted-foreground">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 border-l-2 border-primary pl-2.5 font-heading text-sm font-semibold tracking-normal uppercase">
                {f.title}
              </h3>
              <p class="mt-3 font-mono text-xs leading-relaxed text-muted-foreground">
                {f.body}
              </p>
              <a
                href={`${APP_URL}/app`}
                class="mt-5 inline-flex items-center gap-2 font-heading text-[11px] font-semibold tracking-widest text-primary uppercase transition-opacity hover:opacity-70"
              >
                Learn more
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </div>

  <!-- By the numbers -->
  <section class="mx-auto max-w-7xl px-5 md:px-8 pb-6">
    <div class="relative overflow-hidden bg-neutral-950 px-6 py-8 text-white md:px-10 md:py-10">
      <CornerMarks class="text-primary" omit={['br']} />
      <p class="font-mono text-xs tracking-normal text-primary uppercase">
        // By the numbers
      </p>
      <div
        class="mt-8 grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4 md:gap-0 md:divide-x md:divide-neutral-800"
      >
        {
          stats.map((s) => (
            <div class="flex items-start gap-3.5 md:px-6 md:first:pl-0">
              <Icon name={s.icon} class="h-8 w-8 shrink-0 text-white/90" />
              <div class="flex flex-col">
                <span class="font-heading text-3xl font-semibold leading-none text-primary">
                  {s.value}
                </span>
                <span class="mt-2 font-mono text-[11px] font-bold tracking-widest text-white uppercase">
                  {s.label}
                </span>
                <span class="mt-1.5 font-mono text-[11px] leading-relaxed text-neutral-400">
                  {s.body}
                </span>
              </div>
            </div>
          ))
        }
      </div>
      <div class="fw-hazard absolute right-2 bottom-2 h-2.5 w-16 text-white"></div>
    </div>
  </section>

  <!-- CTA band -->
  <section>
    <div class="mx-auto max-w-7xl px-5 md:px-8 pb-6">
      <div class="relative overflow-hidden bg-primary text-primary-foreground">
        <CornerMarks class="text-white/40" omit={['br']} />
        <div
          class="flex flex-col gap-8 px-6 py-5 md:flex-row md:items-center md:justify-between md:px-12 md:py-7"
        >
          <div class="flex flex-col gap-4">
            <p class="font-mono text-xs tracking-normal text-white/80 uppercase">
              <span class="text-white">//</span> Ready to level up?
            </p>
            <h2
              class="font-heading text-[clamp(1.5rem,5vw,4rem)] text-center md:text-left font-semibold leading-[0.95] tracking-tight uppercase"
            >
              Your next level <br class="hidden md:inline" />starts now.
            </h2>
          </div>
          <a
            href={`${APP_URL}/app`}
            class="fw-notch-tl inline-flex items-center justify-between gap-6 bg-white px-7 py-4 font-heading text-lg font-semibold tracking-widest text-foreground uppercase transition-colors hover:bg-white/90 md:text-xs"
          >
            <span class="inline-flex items-center gap-2.5">
              <Icon name="crosshair" class="h-8 w-8 text-primary" />
              Start Your Session
            </span>
            <Icon name="arrow" class="h-8 w-8 text-primary" />
          </a>
        </div>
        <div class="fw-hazard absolute right-0 bottom-1 h-2.5 w-18 text-white"></div>
      </div>
    </div>
  </section>
</Base>
