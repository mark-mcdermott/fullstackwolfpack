---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import HeroWolf from '../components/HeroWolf.astro'
import { APP_URL } from '../consts'

const lostItems = [
  {
    icon: 'compass',
    title: 'Check the URL',
    body: 'Make sure the address is typed correctly.',
  },
  {
    icon: 'book',
    title: 'Browse Features',
    body: 'Explore what Wolfpack has to offer.',
  },
  {
    icon: 'search',
    title: 'Search',
    body: 'Use search to find lessons and guides.',
  },
] as const

const triTopRight =
  'border-width: 18px 18px 0 0; border-style: solid; border-color: transparent var(--foreground) transparent transparent;'
const triBottomRight =
  'border-width: 0 0 18px 18px; border-style: solid; border-color: transparent transparent var(--foreground) transparent;'
---

<Base
  title="Page not found — Fullstack Wolfpack"
  description="404 — target not found. The page you're looking for doesn't exist or has been moved."
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-10 pb-10">
      <div class="grid items-center gap-y-10 md:grid-cols-2 md:gap-x-10">
        <div class="flex flex-col gap-6">
          <p class="font-mono text-xs tracking-normal text-primary uppercase">// Error</p>
          <div>
            <p class="font-heading text-[7rem] font-semibold leading-[0.8] sm:text-[9rem] lg:text-[11rem]">
              404
            </p>
            <h1
              class="mt-3 font-heading text-4xl leading-[0.95] tracking-tight uppercase sm:text-5xl"
            >
              Target not found<span class="text-primary">.</span>
            </h1>
          </div>

          <!-- Glitch barcode line -->
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="fw-barcode h-2.5 w-40 text-foreground/70"></span>
            <span class="h-2.5 w-20 bg-primary"></span>
            <span class="fw-barcode h-2.5 w-10 text-foreground/40"></span>
            <span class="h-2.5 w-2.5 bg-primary"></span>
          </div>

          <p class="max-w-md font-mono text-[15px] leading-relaxed text-neutral-700">
            The page you're looking for doesn't exist or has been moved.<br />
            Let's get you back on track.
          </p>

          <div class="flex flex-col gap-4 sm:max-w-md">
            <a
              href="/"
              class="fw-notch-br flex items-center gap-4 bg-primary px-6 py-4 font-heading text-sm font-bold tracking-widest text-primary-foreground uppercase transition-colors hover:bg-primary/90"
            >
              <Icon name="crosshair" class="h-6 w-6" />
              <span class="h-6 w-px bg-white/40"></span>
              Return home
              <Icon name="arrow" class="ml-auto h-5 w-5" />
            </a>
            <a
              href="/features"
              class="flex items-center gap-4 border border-foreground px-6 py-4 font-heading text-sm font-bold tracking-widest uppercase transition-colors hover:bg-foreground hover:text-background"
            >
              <Icon name="hexagon" class="h-6 w-6" />
              <span class="h-6 w-px bg-foreground/20"></span>
              Explore features
              <Icon name="arrow" class="ml-auto h-5 w-5" />
            </a>
          </div>
        </div>

        <HeroWolf
          src="/images/wolf-sun.png"
          alt="Ink illustration of a wolf standing before a red rising sun"
        />
      </div>
    </section>

    <!-- Lost? try these -->
    <section class="pb-10">
      <div class="relative border border-neutral-600 px-6 py-10 md:px-10">
        <span class="pointer-events-none absolute right-0 top-0 h-0 w-0" style={triTopRight}></span>
        <span
          class="pointer-events-none absolute right-0 bottom-0 h-0 w-0"
          style={triBottomRight}></span>
        <div class="fw-hazard pointer-events-none absolute right-9 bottom-3.5 h-2 w-12 text-foreground/70"></div>
        <p class="font-mono text-[11px] tracking-widest text-primary uppercase">
          // Lost? Try these
        </p>
        <div
          class="mt-8 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-neutral-300"
        >
          {
            lostItems.map((it) => (
              <div class="relative isolate flex flex-col items-center text-center sm:px-6">
                <span
                  class="fw-diaglines pointer-events-none absolute inset-2 -z-10 text-foreground opacity-[0.015]"
                  aria-hidden="true"
                />
                <span class="relative inline-flex h-16 w-16 items-center justify-center">
                  <Icon name="hexagon" class="absolute inset-0 h-full w-full text-foreground/30" />
                  <Icon name={it.icon} class="h-6 w-6 text-foreground" />
                </span>
                <h3 class="mt-4 font-heading text-sm font-semibold tracking-normal uppercase">
                  {it.title}
                </h3>
                <p class="mt-2 font-mono text-xs leading-relaxed text-muted-foreground">
                  {it.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Mini CTA -->
    <section class="pb-16 text-center">
      <p class="font-mono text-sm text-muted-foreground">
        Ready to level up your skills?
      </p>
      <a
        href={`${APP_URL}/app`}
        class="mt-3 inline-flex items-center gap-2 font-heading text-xs font-semibold tracking-widest text-primary uppercase transition-opacity hover:opacity-70"
      >
        Start Learning
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </section>
  </div>
</Base>
