---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<Base title="Blog — Fullstack Wolfpack">
  <section class="mx-auto max-w-3xl px-5 py-16">
    <p class="font-mono text-xs tracking-widest text-primary uppercase">// Blog</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight uppercase">Field notes</h1>

    <div class="mt-10 flex flex-col divide-y divide-border">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group flex items-center gap-5 py-6">
            {post.data.image && (
              <img
                src={post.data.image}
                alt=""
                class="hidden h-20 w-28 shrink-0 object-cover sm:block"
              />
            )}
            <div>
              <h2 class="text-lg font-bold tracking-tight uppercase group-hover:text-primary">
                {post.data.title}
              </h2>
              <p class="mt-1 font-mono text-xs text-muted-foreground">
                {post.data.description}
              </p>
              <p class="mt-2 font-mono text-[10px] tracking-widest text-muted-foreground uppercase">
                {fmt(post.data.date)}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
