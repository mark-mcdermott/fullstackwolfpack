---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import HeroWolf from '../components/HeroWolf.astro'
import Field from '../components/Field.astro'
import SocialAuth from '../components/SocialAuth.astro'
import WhyBox from '../components/WhyBox.astro'

const requirements = [
  { key: 'len', label: 'At least 8 characters' },
  { key: 'upper', label: 'One uppercase letter' },
  { key: 'num', label: 'One number or symbol' },
] as const

const whyItems = [
  {
    icon: 'target',
    title: 'Real World Skills',
    body: 'Learn practical skills used by developers every day.',
  },
  {
    icon: 'gamepad',
    title: 'Learn by Doing',
    body: 'Interactive lessons, challenges, and hands-on practice.',
  },
  {
    icon: 'bars',
    title: 'Track Progress',
    body: 'See your growth, earn XP, and level up your skills.',
  },
  {
    icon: 'trophy',
    title: 'Earn Rewards',
    body: 'Unlock achievements and prove your expertise.',
  },
] as const

const triTopRight =
  'border-width: 18px 0 0 18px; border-style: solid; border-color: var(--foreground) transparent transparent transparent;'
const triBottomLeft =
  'border-width: 18px 0 0 18px; border-style: solid; border-color: transparent transparent transparent var(--foreground);'
---

<Base
  title="Sign up — Fullstack Wolfpack"
  description="Create your account and join the pack. Start your journey — learn, play, level up."
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-10 pb-8">
      <div class="grid items-center gap-y-10 md:grid-cols-2 md:gap-x-10">
        <div class="flex max-w-xl flex-col gap-6">
          <p class="font-mono text-xs tracking-normal text-primary uppercase">
            // Join the pack
          </p>
          <h1
            class="font-heading text-4xl leading-[0.95] tracking-tight uppercase sm:text-5xl lg:text-[3.5rem]"
          >
            <span class="block">Create</span>
            <span class="block">your <span class="text-primary">account.</span></span>
          </h1>
          <p class="max-w-md font-mono text-[15px] leading-relaxed tracking-wide text-neutral-700 uppercase">
            Start your journey.<br />Learn. Play. Level up.
          </p>
        </div>
        <HeroWolf />
      </div>
    </section>

    <!-- Form card -->
    <section class="pb-10">
      <div class="relative overflow-hidden border border-neutral-300 bg-background p-6 sm:p-10">
        <span class="pointer-events-none absolute right-0 top-0 h-0 w-0" style={triTopRight}></span>
        <span class="pointer-events-none absolute left-0 bottom-0 h-0 w-0" style={triBottomLeft}></span>
        <p class="font-mono text-xs tracking-normal text-primary uppercase">// Sign up</p>
        <form data-auth-form class="mt-8">
          <div class="grid gap-x-8 gap-y-6 md:grid-cols-2">
            <Field
              label="Full name"
              name="name"
              icon="user"
              placeholder="Enter your full name"
              autocomplete="name"
              required
            />
            <Field
              label="Email address"
              name="email"
              type="email"
              icon="mail"
              placeholder="Enter your email"
              autocomplete="email"
              required
            />
            <Field
              label="Username"
              name="username"
              icon="at"
              placeholder="Choose a username"
              autocomplete="username"
              required
            />
            <Field
              label="Password"
              name="password"
              type="password"
              icon="lock"
              placeholder="Create a password"
              autocomplete="new-password"
              toggle
              required
            />

            <!-- Password strength -->
            <div>
              <p class="font-mono text-[11px] font-bold tracking-widest text-foreground uppercase">
                Password strength
              </p>
              <div class="mt-3 flex gap-2">
                {
                  Array.from({ length: 5 }).map(() => (
                    <span data-strength-bar class="strength-bar h-1.5 flex-1 bg-neutral-300" />
                  ))
                }
              </div>
            </div>

            <!-- Requirements -->
            <ul class="flex flex-col justify-center gap-2">
              {
                requirements.map((r) => (
                  <li
                    data-req={r.key}
                    class="req flex items-center gap-2 font-mono text-[13px] text-muted-foreground"
                  >
                    <Icon name="circle-check" class="req-icon h-4 w-4 shrink-0" />
                    {r.label}
                  </li>
                ))
              }
            </ul>

            <Field
              label="Confirm password"
              name="confirm"
              type="password"
              icon="lock"
              placeholder="Confirm your password"
              autocomplete="new-password"
              toggle
              required
            />
            <div class="hidden md:block" aria-hidden="true"></div>

            <button
              type="submit"
              class="fw-notch-br flex w-full items-center gap-4 bg-primary px-6 py-4 font-heading text-sm font-bold tracking-widest text-primary-foreground uppercase transition-colors hover:bg-primary/90"
            >
              <Icon name="crosshair" class="h-6 w-6" />
              <span class="h-6 w-px bg-white/40"></span>
              Create account
              <Icon name="arrow" class="ml-auto h-5 w-5" />
            </button>
          </div>

          <div class="mt-9 flex flex-col gap-6">
            <SocialAuth label="Or sign up with" />
            <p class="text-center font-mono text-sm text-muted-foreground">
              Already have an account?{' '}
              <a
                href="/signin"
                class="text-primary underline decoration-dotted underline-offset-4 transition-opacity hover:opacity-80"
              >
                Log in
              </a>
            </p>
          </div>
        </form>
      </div>
    </section>

    <!-- Why join -->
    <section class="pb-14">
      <WhyBox eyebrow="Why join Fullstack Wolfpack?" items={whyItems} />
    </section>
  </div>
</Base>

<style>
  .strength-bar.is-on {
    background-color: var(--primary);
  }
  .req.is-met {
    color: var(--foreground);
  }
  .req.is-met .req-icon {
    color: var(--primary);
  }
</style>

<script>
  // Password visibility toggles.
  document.querySelectorAll('[data-pw-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = btn.closest('.relative')?.querySelector('input')
      if (!input) return
      const reveal = input.type === 'password'
      input.type = reveal ? 'text' : 'password'
      btn.querySelector('.pw-eye')?.classList.toggle('hidden', reveal)
      btn.querySelector('.pw-eye-off')?.classList.toggle('hidden', !reveal)
      btn.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password')
    })
  })

  // Live password strength meter + requirement checklist.
  const pw = document.getElementById('password') as HTMLInputElement | null
  const bars = [...document.querySelectorAll('[data-strength-bar]')]
  const reqEls: Record<string, Element | null> = {
    len: document.querySelector('[data-req="len"]'),
    upper: document.querySelector('[data-req="upper"]'),
    num: document.querySelector('[data-req="num"]'),
  }
  pw?.addEventListener('input', () => {
    const v = pw.value
    const checks = {
      len: v.length >= 8,
      upper: /[A-Z]/.test(v),
      num: /[0-9]/.test(v) || /[^A-Za-z0-9]/.test(v),
    }
    for (const [k, ok] of Object.entries(checks)) {
      reqEls[k]?.classList.toggle('is-met', ok)
    }
    let score = 0
    if (v.length > 0) score++
    if (checks.len) score++
    if (checks.upper) score++
    if (checks.num) score++
    if (v.length >= 12) score++
    bars.forEach((b, i) => b.classList.toggle('is-on', i < score))
  })

  // No auth backend on the static site — hand off to the app.
  const form = document.querySelector('[data-auth-form]')
  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    window.location.href = 'https://app.fullstackwolfpack.com/app'
  })
</script>
