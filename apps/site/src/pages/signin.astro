---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import HeroWolf from '../components/HeroWolf.astro'
import Field from '../components/Field.astro'
import SocialAuth from '../components/SocialAuth.astro'
import WhyBox from '../components/WhyBox.astro'
import { APP_URL } from '../consts'

const whyItems = [
  {
    icon: 'target',
    title: 'Save Progress',
    body: 'Your progress is saved and ready whenever you are.',
  },
  {
    icon: 'bars',
    title: 'Track Growth',
    body: 'See your stats, streaks, and real world progress.',
  },
  {
    icon: 'gamepad',
    title: 'Unlock Content',
    body: 'Access lessons, challenges, and exclusive features.',
  },
  {
    icon: 'trophy',
    title: 'Earn Rewards',
    body: 'Level up, earn XP, and unlock new achievements.',
  },
] as const

const triTopRight =
  'border-width: 18px 18px 0 0; border-style: solid; border-color: transparent var(--foreground) transparent transparent;'
const triBottomLeft =
  'border-width: 18px 0 0 18px; border-style: solid; border-color: transparent transparent transparent var(--foreground);'
---

<Base
  title="Sign in — Fullstack Wolfpack"
  description="Sign in to continue your journey. Pick up where you left off and keep leveling up."
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-10 pb-8">
      <div class="grid items-center gap-y-10 md:grid-cols-2 md:gap-x-10">
        <div class="flex max-w-xl flex-col gap-6">
          <p class="font-mono text-xs tracking-normal text-primary uppercase">
            // Welcome back
          </p>
          <h1
            class="font-heading text-4xl leading-[0.95] tracking-tight uppercase sm:text-5xl lg:text-[3.5rem]"
          >
            <span class="block">Sign in</span>
            <span class="block">to continue</span>
            <span class="block">your <span class="text-primary">journey.</span></span>
          </h1>
          <p class="max-w-md font-mono text-[15px] leading-relaxed text-neutral-700">
            Pick up where you left off.<br />Keep learning. Keep leveling up.
          </p>
        </div>
        <HeroWolf fm="FW · 02" />
      </div>
    </section>

    <!-- Form card -->
    <section class="pb-10">
      <div class="relative mx-auto max-w-4xl overflow-hidden border border-neutral-300 bg-background p-6 sm:p-10">
        <span class="pointer-events-none absolute right-0 top-0 h-0 w-0" style={triTopRight}></span>
        <span class="pointer-events-none absolute left-0 bottom-0 h-0 w-0" style={triBottomLeft}></span>
        <p class="font-mono text-xs tracking-normal text-primary uppercase">// Sign in</p>
        <form data-auth-form class="mt-8 flex flex-col gap-6">
          <Field
            label="Email or username"
            name="identifier"
            icon="mail"
            placeholder="Enter your email or username"
            autocomplete="username"
            required
          />
          <Field
            label="Password"
            name="password"
            type="password"
            icon="lock"
            placeholder="Enter your password"
            autocomplete="current-password"
            toggle
            required
          />
          <div class="flex flex-wrap items-center justify-between gap-3">
            <label class="flex items-center gap-2.5 font-mono text-sm text-neutral-700">
              <input
                type="checkbox"
                checked
                style="accent-color: var(--primary)"
                class="h-4 w-4"
              />
              Remember me
            </label>
            <a
              href={`${APP_URL}/app`}
              class="font-mono text-sm text-foreground underline decoration-dotted decoration-[color:var(--primary)] underline-offset-4 transition-colors hover:text-primary"
            >
              Forgot your password?
            </a>
          </div>
          <button
            type="submit"
            class="fw-notch-br flex items-center gap-4 bg-primary px-6 py-4 font-heading text-sm font-bold tracking-widest text-primary-foreground uppercase transition-colors hover:bg-primary/90"
          >
            <Icon name="crosshair" class="h-6 w-6" />
            <span class="h-6 w-px bg-white/40"></span>
            Sign in
            <Icon name="arrow" class="ml-auto h-5 w-5" />
          </button>
          <SocialAuth label="Or continue with" />
          <p class="text-center font-mono text-sm text-muted-foreground">
            Don't have an account?{' '}
            <a
              href="/signup"
              class="text-primary underline decoration-dotted underline-offset-4 transition-opacity hover:opacity-80"
            >
              Sign up
            </a>
          </p>
        </form>
      </div>
    </section>

    <!-- Why sign in -->
    <section class="pb-14">
      <WhyBox eyebrow="Why sign in?" items={whyItems} />
    </section>
  </div>
</Base>

<script>
  // Password visibility toggles.
  document.querySelectorAll('[data-pw-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = btn.closest('.relative')?.querySelector('input')
      if (!input) return
      const reveal = input.type === 'password'
      input.type = reveal ? 'text' : 'password'
      btn.querySelector('.pw-eye')?.classList.toggle('hidden', reveal)
      btn.querySelector('.pw-eye-off')?.classList.toggle('hidden', !reveal)
      btn.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password')
    })
  })

  // No auth backend on the static site — hand off to the app.
  const form = document.querySelector('[data-auth-form]')
  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    window.location.href = 'https://app.fullstackwolfpack.com/app'
  })
</script>
