{
  "rewrites": [
    { "source": "/app",        "destination": "https://fullstackwolfpack.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://fullstackwolfpack.vercel.app/app/:path*" },
    { "source": "/api/:path*", "destination": "https://fullstackwolfpack.vercel.app/api/:path*" },
    { "source": "/login",      "destination": "https://fullstackwolfpack.vercel.app/login" },
    { "source": "/signup",     "destination": "https://fullstackwolfpack.vercel.app/signup" },
    { "source": "/admin",      "destination": "https://fullstackwolfpack.vercel.app/admin" }
  ]
}