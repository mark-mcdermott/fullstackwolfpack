# Single Astro deployment (see docs/astro-merge-plan.md). One origin serves the
# static pages, the React applet, AND /api/*, so there's no cross-origin plumbing.
# astro.config loads this file into process.env so the API endpoints can read
# server-side vars under `astro dev` (Astro's dev server runs on port 4321).

# Neon Postgres connection string — SERVER-SIDE ONLY, never expose to the client.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# WebAuthn relying party config. Local dev = localhost + the astro dev origin.
# PRODUCTION (single origin, the apex): RP_ID="fullstackwolfpack.com",
# RP_ORIGIN="https://fullstackwolfpack.com". A passkey registered at the apex
# also works on any subdomain of it.
RP_ID="localhost"
RP_ORIGIN="http://localhost:4321"

# Session cookie signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# At-rest encryption key for stored secrets (TOTP + provider API keys).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-long-random-string"

# Dev Mode role switcher (deleted-later feature). Always on in local dev.
# Set to 1 on a DEPLOY to expose the top-right role switcher there too.
# WARNING: while enabled, POST /api/me/become mints a session for a test user
# with NO auth. If you enable this in an environment reachable by others, also
# add an Astro middleware IP allowlist at src/middleware.ts (the old Vercel-edge
# version is in git history at apps/web/middleware.ts). Leave unset in any env
# with real users.
# VITE_ENABLE_DEV_MODE="1"

# AI tutor + short-answer grading. Users normally add their own key in Settings
# (encrypted per-user); these optional PLATFORM keys are a fallback. Claude preferred.
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# Model overrides (defaults: Haiku 4.5 grader, Sonnet 5 tutor, gpt-4o-mini):
# ANTHROPIC_GRADER_MODEL="claude-haiku-4-5"
# ANTHROPIC_TUTOR_MODEL="claude-sonnet-5"
# OPENAI_MODEL="gpt-4o-mini"

# Stripe billing (Pro subscription). SERVER-SIDE ONLY. Dormant until keyed.
# Redirect URLs derive from RP_ORIGIN. For local dev:
#   stripe listen --forward-to localhost:4321/api/me/stripe-webhook
# For prod, point a Dashboard webhook at
#   https://fullstackwolfpack.com/api/me/stripe-webhook
# subscribed to checkout.session.completed, customer.subscription.updated, .deleted.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Native / desktop shells (Capacitor + Tauri). Neither bundles the app: auth is
# WebAuthn RP-origin-bound, so a webview serving from capacitor://localhost or
# tauri://localhost could never authenticate. Both point the whole webview at the
# deployed origin (the apex) and ship `native-shell/` — a ~1KB offline notice —
# instead of dist/client. Since the Astro merge there is nothing to bundle
# anyway: the applet route is prerender=false, so /app is not in the static build.
#   - CAP_SERVER_URL: the origin Capacitor loads. Set it and `cap:sync:prod`
#     switches webDir to native-shell. Unset (local dev) bundles dist/client.
#   - Tauri's equivalent is the window `url` in src-tauri/tauri.prod.conf.json,
#     applied by `npm run tauri:build:prod`. Plain `tauri build` ships only the
#     offline notice; `tauri dev` uses devUrl (localhost:4321) and works fully.
#   - VITE_API_BASE: build-time prefix for /api/* calls. Leave empty — the shells
#     load the origin itself, so every request is already same-origin.
# CAP_SERVER_URL="https://fullstackwolfpack.com"

# Arcade embed-game sandbox origin. HTML5 embed games under public/games/ run in a
# sandboxed iframe; served same-origin by default. Point at a dedicated games
# origin to drop `allow-same-origin` for full isolation of the third-party code.
# VITE_GAMES_ORIGIN="https://games.fullstackwolfpack.com"

# Community realtime push (optional). Unset = Community runs on polling (fully
# functional). Set an Ably API key to enable instant DM delivery (the server mints
# short-lived subscribe-only tokens; the key never reaches the client).
# ABLY_API_KEY="xxxxx.yyyyy:zzzzzzzzzzzzzzzz"
